# ========================================================
# ⚙️ WA-Radar-Server Configuration (إعدادات السيرفر)
# ========================================================
# تنبيه: قم بتغيير اسم هذا الملف إلى .env بعد إدخال بياناتك
# ========================================================

# 1️⃣ توكن بوت تيليجرام (Bot Token)
# --------------------------------------------------------
# إزاي تجيبه؟
# 1. افتح تطبيق تيليجرام وابحث عن @BotFather
# 2. ابعتله أمر /newbot واتبع الخطوات لاختيار اسم للبوت
# 3. في النهاية هيبعتلك رسالة فيها الـ Token، انسخه وحطه هنا
TG_TOKEN=your_bot_token_here

# 2️⃣ معرف الدردشة (Chat ID)
# --------------------------------------------------------
# إزاي تجيبه؟
# 1. افتح تطبيق تيليجرام وابحث عن البوت @userinfobot
# 2. ابعتله أمر /start
# 3. هيرد عليك برسالة فيها رقم الـ Id بتاعك، انسخه وحطه هنا
TG_CHAT_ID=your_chat_id_here
